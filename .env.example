# MedAuth AI — environment variable reference.
#
# Copy to .env.local and fill in for local development:  cp .env.example .env.local
# NEVER commit .env.local. NEVER put a real secret in this file — names only.
# In every deployed environment these values come from AWS Secrets Manager.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
ENVIRONMENT=
LOG_LEVEL=

# ---------------------------------------------------------------------------
# AWS — us-east-1 only (HIPAA-eligible services, BAA signed)
# Local dev uses the `medauth-dev` IAM profile; Bedrock is the only AWS service
# actually called during local dev (no local mock available).
# ---------------------------------------------------------------------------
AWS_REGION=
AWS_PROFILE=
AWS_SECRETS_MANAGER_PREFIX=

# Bedrock — Haiku for extraction, Sonnet for reasoning (see CLAUDE.md)
BEDROCK_MODEL_ID_FAST=
BEDROCK_MODEL_ID_REASONING=

# Transcribe Medical — the streaming transcription behind audio-ingestion.
# Sample rate and encoding must match what apps/web and apps/mobile capture
# (TASK-022/023 both record 16kHz mono); a mismatch makes the stream hang rather
# than fail, which is the worst failure mode to debug.
TRANSCRIBE_MEDICAL_LANGUAGE_CODE=
TRANSCRIBE_MEDICAL_SPECIALTY=
TRANSCRIBE_MEDICAL_TYPE=
TRANSCRIBE_MEDICAL_SAMPLE_RATE_HZ=
TRANSCRIBE_MEDICAL_MEDIA_ENCODING=

# KMS — key encryption key for packages/crypto-utils
KMS_KEK_ARN=

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=

# ---------------------------------------------------------------------------
# Redis — pub/sub message bus + RAG result cache
# ---------------------------------------------------------------------------
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_URL=
RAG_CACHE_TTL_SECONDS=

# ---------------------------------------------------------------------------
# Qdrant — self-hosted vector store
# ---------------------------------------------------------------------------
QDRANT_HOST=
QDRANT_PORT=
QDRANT_API_KEY=
QDRANT_COLLECTION=

# Embeddings — local sentence-transformers model, no external API
EMBEDDING_MODEL_NAME=
EMBEDDING_DIMENSIONS=

# ---------------------------------------------------------------------------
# Da Vinci CRD — the standardized payer API tier in front of the RAG path
# (TASK-015). Locally this is the HL7 CRD Reference Implementation from
# docker-compose.yml; in a deployed environment it is the payer's own endpoint.
# Leave CRD_BASE_URL empty to turn the tier off entirely — every query then
# takes the RAG path, exactly as it did before TASK-015.
# ---------------------------------------------------------------------------
CRD_BASE_URL=
CRD_TIMEOUT_SECONDS=

# ---------------------------------------------------------------------------
# Policy query loopback (TASK-021). track-b-rag's transcript consumer calls its
# own POST /policies/query over HTTP rather than importing the function behind
# it, so that the route's audit_log() write stays the single place a
# PHI-carrying policy query is recorded. This is therefore track-b-rag's own
# address — port 8002 locally, the service address in a cluster.
# ---------------------------------------------------------------------------
POLICY_QUERY_BASE_URL=
POLICY_QUERY_TIMEOUT_SECONDS=

# ---------------------------------------------------------------------------
# Service URLs (see CLAUDE.md for the local port map)
# ---------------------------------------------------------------------------
AUDIO_INGESTION_URL=
TRACK_A_CLINICAL_URL=
TRACK_B_RAG_URL=
FHIR_INTEGRATION_URL=
NUDGE_SERVICE_URL=

# ---------------------------------------------------------------------------
# Session auth (JWT on the audio WebSocket + service-to-service calls)
# ---------------------------------------------------------------------------
JWT_SIGNING_KEY=
JWT_ISSUER=
JWT_AUDIENCE=
SESSION_TTL_SECONDS=
# How long past a token's exp it may still authorise POST /sessions/{id}/token
# (TASK-006b). It bounds how long one captured token stays useful; it does not
# bound a live client, which is expected to keep refreshing.
# The 3600 default is an ASSUMPTION, not a measurement — picked when TASK-006b
# was built and not yet validated against a real visit. See the comment on
# DEFAULT_REMINT_GRACE_SECONDS in track-a-clinical's config.py.
SESSION_REMINT_GRACE_SECONDS=

# ---------------------------------------------------------------------------
# CORS (browser-facing routes — TASK-041c)
#
# Comma-separated browser origins the HTTP routes answer, and the origins the
# WebSocket endpoints accept a handshake from. Read by track-a-clinical,
# track-b-rag, audio-ingestion and nudge-service.
#
# Empty means this service answers no browser. That is deliberately the default
# rather than a baked-in localhost value, which would ship to production the
# first time someone forgot the variable. For local development set it to the
# Vite dev server:
#
#     CORS_ALLOWED_ORIGINS=http://localhost:5173
#
# `*` is rejected at startup, not merely discouraged: these services answer with
# PHI. See CLAUDE.md, "CORS and browser reachability".
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# FHIR — local dev server (HAPI FHIR in docker compose)
# ---------------------------------------------------------------------------
FHIR_VERSION=
LOCAL_FHIR_BASE_URL=
SMART_REDIRECT_URI=
SMART_SCOPES=

# ---------------------------------------------------------------------------
# EHR vendor sandboxes — build order is Athena first (see CLAUDE.md).
# Register at developer.athenahealth.com for the first set.
# ---------------------------------------------------------------------------
ATHENA_CLIENT_ID=
ATHENA_CLIENT_SECRET=
ATHENA_FHIR_BASE_URL=

ECW_CLIENT_ID=
ECW_CLIENT_SECRET=
ECW_FHIR_BASE_URL=

MODMED_CLIENT_ID=
MODMED_CLIENT_SECRET=
MODMED_FHIR_BASE_URL=

CERNER_CLIENT_ID=
CERNER_CLIENT_SECRET=
CERNER_FHIR_BASE_URL=

EPIC_CLIENT_ID=
EPIC_CLIENT_SECRET=
EPIC_FHIR_BASE_URL=

# ---------------------------------------------------------------------------
# Prior authorization submission fallback (payers without FHIR PAS)
# ---------------------------------------------------------------------------
COVERMYMEDS_API_KEY=
COVERMYMEDS_BASE_URL=

# ---------------------------------------------------------------------------
# Policy scraper — CMS Medicare coverage database (public, no auth)
#
# CMS_COVERAGE_DB_BASE_URL is the database UI (www.cms.gov), used for the
# provenance URL recorded against each policy. CMS_MCD_EXPORTS_BASE_URL is the
# daily CSV exports, which are on a different host (downloads.cms.gov) — they
# are separate variables because robots.txt is per host.
#
# POLICY_SCRAPER_USER_AGENT must name this scraper AND carry a contact email;
# the service refuses to start without one. cms.gov also answers 403 to some
# clients on User-Agent alone, so this is load-bearing, not courtesy alone.
# ---------------------------------------------------------------------------
CMS_COVERAGE_DB_BASE_URL=
CMS_MCD_EXPORTS_BASE_URL=
POLICY_SCRAPER_USER_AGENT=

# ---------------------------------------------------------------------------
# Frontend (apps/web — Vite requires the VITE_ prefix to expose a var)
#
# VITE_* values are inlined into the shipped bundle, so a host name is fine here
# and a credential never is. The session JWT is minted per encounter by TASK-006
# and handed to the hooks — it is not configuration.
#
# The two WebSocket origins carry no path; each hook appends its own
# (/ws/audio/{session_id}, /ws/nudges/{session_id}). Both must be wss:// anywhere
# but localhost — one carries encounter audio and both carry a session token.
#
# The two HTTP origins are separate because they are separate services:
# VITE_API_BASE_URL is track-a-clinical, which owns the session lifecycle and
# mints the tokens those sockets need (TASK-006/006b), and VITE_TRACK_B_RAG_URL
# is track-b-rag, which owns the nudge acknowledge route (TASK-041b). Do not
# collapse them into one until something actually puts both services behind one
# origin — the gateway deferred to Phase 6 in CLAUDE.md, "CORS and browser
# reachability".
#
# This block said until TASK-043 that apps/mobile needed only the first, "which
# is why its EXPO_PUBLIC_API_BASE_URL has no counterpart". That was true only
# while mobile had no dismiss button. It now calls the same acknowledge route on
# track-b-rag and has the same two HTTP origins for the same two services — see
# the mobile block below.
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=
VITE_TRACK_B_RAG_URL=
VITE_NUDGE_WS_URL=
VITE_AUDIO_WS_URL=

# ---------------------------------------------------------------------------
# Mobile (apps/mobile — Expo requires the EXPO_PUBLIC_ prefix)
#
# EXPO_PUBLIC_* values are inlined into the shipped bundle, so a host name is
# fine here and a credential never is. The session JWT is minted per encounter
# by TASK-006 and passed to the capture hook — it is not configuration.
#
# This app has four origins: two WebSocket and two HTTP, and none of them are
# interchangeable. A build that reuses one for another fails in a way that reads
# like a routing bug rather than a configuration one, which is why each is its
# own variable.
#
# The two WebSocket origins carry no path; each hook appends its own.
# EXPO_PUBLIC_AUDIO_WS_URL is audio-ingestion, and useAudioCapture (TASK-022)
# appends /ws/audio/{session_id}. EXPO_PUBLIC_NUDGE_WS_URL is nudge-service, and
# useNudgeStream (TASK-043) appends /ws/nudges/{session_id}. Both must be wss://
# anywhere but localhost: one carries encounter audio, the other a live stream of
# payer alerts naming an encounter's undocumented criteria, and both carry a
# session token in the handshake.
#
# The two HTTP origins are two services, exactly as on web.
# EXPO_PUBLIC_API_BASE_URL is track-a-clinical, which owns the session lifecycle
# routes (TASK-025) and the re-mint endpoint both sockets depend on.
# EXPO_PUBLIC_TRACK_B_RAG_URL is track-b-rag, which owns the nudge acknowledge
# route the banner's dismiss button calls (TASK-041b, wired up in TASK-043).
# Both must be https:// anywhere but localhost — the start-visit body carries a
# patient identifier, and a dismissal names a nudge belonging to an encounter.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_TRACK_B_RAG_URL=
EXPO_PUBLIC_NUDGE_WS_URL=
EXPO_PUBLIC_AUDIO_WS_URL=
