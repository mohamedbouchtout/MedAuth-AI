# MedAuth AI — environment variable reference.
#
# Copy to .env.local and fill in for local development:  cp .env.example .env.local
# NEVER commit .env.local. NEVER put a real secret in this file — names only.
# In every deployed environment these values come from AWS Secrets Manager.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
ENVIRONMENT=
LOG_LEVEL=

# ---------------------------------------------------------------------------
# AWS — us-east-1 only (HIPAA-eligible services, BAA signed)
# Local dev uses the `medauth-dev` IAM profile; Bedrock is the only AWS service
# actually called during local dev (no local mock available).
# ---------------------------------------------------------------------------
AWS_REGION=
AWS_PROFILE=
AWS_SECRETS_MANAGER_PREFIX=

# Bedrock — Haiku for extraction, Sonnet for reasoning (see CLAUDE.md)
BEDROCK_MODEL_ID_FAST=
BEDROCK_MODEL_ID_REASONING=

# Transcribe Medical — the streaming transcription behind audio-ingestion.
# Sample rate and encoding must match what apps/web and apps/mobile capture
# (TASK-022/023 both record 16kHz mono); a mismatch makes the stream hang rather
# than fail, which is the worst failure mode to debug.
TRANSCRIBE_MEDICAL_LANGUAGE_CODE=
TRANSCRIBE_MEDICAL_SPECIALTY=
TRANSCRIBE_MEDICAL_TYPE=
TRANSCRIBE_MEDICAL_SAMPLE_RATE_HZ=
TRANSCRIBE_MEDICAL_MEDIA_ENCODING=

# KMS — key encryption key for packages/crypto-utils
KMS_KEK_ARN=

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=

# ---------------------------------------------------------------------------
# Redis — pub/sub message bus + RAG result cache
# ---------------------------------------------------------------------------
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_URL=
RAG_CACHE_TTL_SECONDS=

# ---------------------------------------------------------------------------
# Qdrant — self-hosted vector store
# ---------------------------------------------------------------------------
QDRANT_HOST=
QDRANT_PORT=
QDRANT_API_KEY=
QDRANT_COLLECTION=

# Embeddings — local sentence-transformers model, no external API
EMBEDDING_MODEL_NAME=
EMBEDDING_DIMENSIONS=

# ---------------------------------------------------------------------------
# Da Vinci CRD — the standardized payer API tier in front of the RAG path
# (TASK-015). Locally this is the HL7 CRD Reference Implementation from
# docker-compose.yml; in a deployed environment it is the payer's own endpoint.
# Leave CRD_BASE_URL empty to turn the tier off entirely — every query then
# takes the RAG path, exactly as it did before TASK-015.
# ---------------------------------------------------------------------------
CRD_BASE_URL=
CRD_TIMEOUT_SECONDS=

# ---------------------------------------------------------------------------
# Policy query loopback (TASK-021). track-b-rag's transcript consumer calls its
# own POST /policies/query over HTTP rather than importing the function behind
# it, so that the route's audit_log() write stays the single place a
# PHI-carrying policy query is recorded. This is therefore track-b-rag's own
# address — port 8002 locally, the service address in a cluster.
# ---------------------------------------------------------------------------
POLICY_QUERY_BASE_URL=
POLICY_QUERY_TIMEOUT_SECONDS=

# ---------------------------------------------------------------------------
# Service URLs (see CLAUDE.md for the local port map)
# ---------------------------------------------------------------------------
AUDIO_INGESTION_URL=
# Read by fhir-integration since TASK-053: POST /fhir/notes reads the note and
# its EHR linkage from track-a-clinical, files the note to the chart, and calls
# back to record the DocumentReference id. Over HTTP rather than by import, for
# the same reason the pairing below is: the READ_NOTE row that service's route
# writes is on the only path to a note's content.
# Also read by prior-auth since TASK-061: the submission router reads a
# request's payer, launch and submittable flag through the narrow
# GET /prior-auth/{request_id}/routing. Narrow deliberately — that payload
# carries no clinical content, so the read writes no audit row, unlike the full
# read the submitter uses. As with FHIR_INTEGRATION_TIMEOUT_SECONDS below, the
# timeout is one knob for both callers.
TRACK_A_CLINICAL_URL=
TRACK_A_CLINICAL_TIMEOUT_SECONDS=
TRACK_B_RAG_URL=
# Read by track-a-clinical since TASK-052b: POST /sessions/start asks
# fhir-integration for the encounter's payer, plan type and site-of-care state
# and writes them onto the encounters row. Over HTTP rather than by import, so
# the audit_log() row that service's route writes cannot be bypassed. A failure
# leaves those columns NULL and still starts the session — a provider unable to
# record a visit is the worse outcome — so the timeout below is short enough
# that someone waiting on "start visit" is not left there.
# Also read by prior-auth since TASK-060: bundle assembly reads the patient's
# chart context through the same route, over HTTP for the same reason — the
# READ_PATIENT row that service's route writes is on the only path to a chart
# read. Note the timeout below is one knob for both callers: prior-auth defaults
# to a longer wait than track-a-clinical because nobody is watching a button for
# it, but setting this variable applies the same value to both.
FHIR_INTEGRATION_URL=
FHIR_INTEGRATION_TIMEOUT_SECONDS=
NUDGE_SERVICE_URL=
PRIOR_AUTH_URL=

# ---------------------------------------------------------------------------
# Prior authorization bundle assembly (TASK-060) and submission routing (TASK-061)
# ---------------------------------------------------------------------------
# How long prior-auth waits between attempts to load the SOAP note it assembles
# from, as a JSON list of seconds. The session-end signal reaches this service
# and track-a-clinical at once and the note takes two Bedrock calls to produce,
# so it routinely does not exist at the first look. Empty means look once.
# Default: [2, 4, 8] — TASK-060's schedule, not a measurement.
NOTE_RETRY_DELAYS=
# How long prior-auth waits for fhir-integration to submit a request to a payer.
# Generous because the work behind it is a round trip to a payer's own endpoint,
# outside our network and our control. Note that a submission which times out is
# genuinely ambiguous — the payer may have taken the request in — so it is never
# retried automatically, and raising this is the right response to a slow payer
# rather than retrying is.
# Default: 30 — a round number, not a measurement.
SUBMISSION_TIMEOUT_SECONDS=

# ---------------------------------------------------------------------------
# Session auth (JWT on the audio WebSocket + service-to-service calls)
# ---------------------------------------------------------------------------
JWT_SIGNING_KEY=
JWT_ISSUER=
JWT_AUDIENCE=
SESSION_TTL_SECONDS=
# How long past a token's exp it may still authorise POST /sessions/{id}/token
# (TASK-006b). It bounds how long one captured token stays useful; it does not
# bound a live client, which is expected to keep refreshing.
# The 3600 default is an ASSUMPTION, not a measurement — picked when TASK-006b
# was built and not yet validated against a real visit. See the comment on
# DEFAULT_REMINT_GRACE_SECONDS in track-a-clinical's config.py.
SESSION_REMINT_GRACE_SECONDS=

# ---------------------------------------------------------------------------
# CORS (browser-facing routes — TASK-041c)
#
# Comma-separated browser origins the HTTP routes answer, and the origins the
# WebSocket endpoints accept a handshake from. Read by track-a-clinical,
# track-b-rag, audio-ingestion, nudge-service and — since TASK-061 —
# prior-auth, whose submission router is called from TASK-072's dashboard.
#
# Empty means this service answers no browser. That is deliberately the default
# rather than a baked-in localhost value, which would ship to production the
# first time someone forgot the variable. For local development set it to the
# Vite dev server:
#
#     CORS_ALLOWED_ORIGINS=http://localhost:5173
#
# `*` is rejected at startup, not merely discouraged: these services answer with
# PHI. See CLAUDE.md, "CORS and browser reachability".
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# FHIR — local dev server (HAPI FHIR in docker compose)
# ---------------------------------------------------------------------------
FHIR_VERSION=
LOCAL_FHIR_BASE_URL=
# Must be byte-for-byte what is registered in each vendor's developer portal.
# A mismatch is refused by the vendor's authorization server before any request
# reaches MedAuth, so it leaves nothing in our logs to diagnose from (TASK-051).
SMART_REDIRECT_URI=
# Scopes requested on every launch, minus the launch-shaped one: TASK-051 appends
# `launch` for an EHR launch and `launch/patient` for a standalone one.
# SMART v2 syntax — `user/*.rs`, not v1's `user/*.read`. CLAUDE.md pins SMART on
# FHIR 2.0 and PKCE and the fhirUser claim already depend on that pin; TASK-051e
# brought the scopes into line. Leave empty to take the v2 default.
SMART_SCOPES=
# How long a launch may sit between the authorization redirect and the callback
# that consumes it. Bounds fhir_launch:{state}; default 600 (10 minutes).
SMART_LAUNCH_TTL_SECONDS=
# How long fhir_token:{launch_id} lives once a launch holds a refresh token.
# This bounds the refresh grant, NOT the access token — the access token carries
# its own expiry inside the record, so a launch survives its token expiring and
# renews instead of forcing a fresh SMART launch. Default 28800 (8 hours), a
# round stand-in for one working day rather than a measurement. It is also how
# long a compromised Redis yields a usable EHR credential, so raise it
# deliberately. A launch whose EHR issued no refresh token ignores this and
# still expires with its access token.
SMART_LAUNCH_RECORD_TTL_SECONDS=
# How far ahead of expiry an EHR access token is renewed, covering clock skew
# between this service and the EHR. Default 120 (2 minutes).
SMART_TOKEN_REFRESH_SKEW_SECONDS=
# Where a completed launch sends the browser, per client platform (TASK-051f).
# Two settings rather than one: a web HTTPS URL and a mobile custom-scheme URI
# are different shapes, and one field holding either would be a value whose
# validity depends on which client happens to use it.
#
# BOTH ARE REQUIRED and fhir-integration refuses to start without them, even in
# a deployment serving one platform. A return target is a deployment-wide
# constant, and the alternative is a launch that fails at the END of an OAuth
# redirect chain — after a human has logged in and a real credential has been
# spent — with nothing on the page saying why.
#
# Web: an absolute https:// URL. http:// is accepted only for localhost and
# 127.0.0.1, which is what Vite and docker compose actually run.
SMART_WEB_RETURN_URL=http://localhost:5173/launch
# Mobile: a custom scheme the OS routes back to the app that opened the auth
# session. Never http/https — a web URL here opens a browser page apps/mobile
# cannot read. Neither value may carry a query string or fragment: the launch
# claim is appended as one.
SMART_MOBILE_RETURN_URI=medauth://launch
# How long a handoff claim code stays redeemable. It bounds a browser redirect
# reaching an app, not anything a human does. Default 120 (2 minutes); it is the
# cheapest lever on how long an intercepted code stays useful.
SMART_LAUNCH_CLAIM_TTL_SECONDS=

# ---------------------------------------------------------------------------
# EHR vendor sandboxes — build order is Athena first (see CLAUDE.md).
# Register at developer.athenahealth.com for the first set.
# ---------------------------------------------------------------------------
ATHENA_CLIENT_ID=
ATHENA_CLIENT_SECRET=
ATHENA_FHIR_BASE_URL=
# The token endpoint the nightly sandbox checks authenticate against. Read by
# tests/integration/test_athena_sandbox.py, which had no entry here until
# TASK-051e — a setting that looked configured and was not. Set it from the same
# platform as ATHENA_FHIR_BASE_URL: athenahealth publishes more than one FHIR
# sandbox and they do not share an identity system, so a client registered on
# one is not merely unauthorized on another, it is unknown. A mismatch surfaces
# as an authentication failure rather than as the configuration error it is.
# Take it from that platform's /.well-known/smart-configuration.
ATHENA_TOKEN_URL=
# The sandbox patient and encounter the nightly checks read and write against.
# The encounter is TASK-053's: a DocumentReference names both, and neither may
# be invented — a fabricated id would file a note against a chart entry that
# does not exist.
ATHENA_TEST_PATIENT_ID=
ATHENA_TEST_ENCOUNTER_ID=

ECW_CLIENT_ID=
ECW_CLIENT_SECRET=
ECW_FHIR_BASE_URL=

MODMED_CLIENT_ID=
MODMED_CLIENT_SECRET=
MODMED_FHIR_BASE_URL=

CERNER_CLIENT_ID=
CERNER_CLIENT_SECRET=
CERNER_FHIR_BASE_URL=

EPIC_CLIENT_ID=
EPIC_CLIENT_SECRET=
EPIC_FHIR_BASE_URL=

# The registration used for an issuer detect_ehr_from_issuer() does not
# recognise, and for the local HAPI FHIR server in development. An unknown EHR
# routes to the standard FHIR adapter (TASK-050), but obtaining a token is a
# client registration, so a launch against one needs credentials of its own.
# Leave unset in an environment that should refuse unrecognised issuers.
GENERIC_CLIENT_ID=
GENERIC_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Prior authorization submission fallback (payers without FHIR PAS)
# ---------------------------------------------------------------------------
COVERMYMEDS_API_KEY=
COVERMYMEDS_BASE_URL=

# ---------------------------------------------------------------------------
# Policy scraper — CMS Medicare coverage database (public, no auth)
#
# CMS_COVERAGE_DB_BASE_URL is the database UI (www.cms.gov), used for the
# provenance URL recorded against each policy. CMS_MCD_EXPORTS_BASE_URL is the
# daily CSV exports, which are on a different host (downloads.cms.gov) — they
# are separate variables because robots.txt is per host.
#
# POLICY_SCRAPER_USER_AGENT must name this scraper AND carry a contact email;
# the service refuses to start without one. cms.gov also answers 403 to some
# clients on User-Agent alone, so this is load-bearing, not courtesy alone.
# ---------------------------------------------------------------------------
CMS_COVERAGE_DB_BASE_URL=
CMS_MCD_EXPORTS_BASE_URL=
POLICY_SCRAPER_USER_AGENT=

# ---------------------------------------------------------------------------
# Frontend (apps/web — Vite requires the VITE_ prefix to expose a var)
#
# VITE_* values are inlined into the shipped bundle, so a host name is fine here
# and a credential never is. The session JWT is minted per encounter by TASK-006
# and handed to the hooks — it is not configuration.
#
# The two WebSocket origins carry no path; each hook appends its own
# (/ws/audio/{session_id}, /ws/nudges/{session_id}). Both must be wss:// anywhere
# but localhost — one carries encounter audio and both carry a session token.
#
# The two HTTP origins are separate because they are separate services:
# VITE_API_BASE_URL is track-a-clinical, which owns the session lifecycle and
# mints the tokens those sockets need (TASK-006/006b), and VITE_TRACK_B_RAG_URL
# is track-b-rag, which owns the nudge acknowledge route (TASK-041b). Do not
# collapse them into one until something actually puts both services behind one
# origin — the gateway deferred to Phase 6 in CLAUDE.md, "CORS and browser
# reachability".
#
# This block said until TASK-043 that apps/mobile needed only the first, "which
# is why its EXPO_PUBLIC_API_BASE_URL has no counterpart". That was true only
# while mobile had no dismiss button. It now calls the same acknowledge route on
# track-b-rag and has the same two HTTP origins for the same two services — see
# the mobile block below.
#
# VITE_FHIR_BASE_URL is fhir-integration, a third service on a third port
# (TASK-070): it owns obtaining a SMART launch and the two routes keyed on one
# that say which patient a visit is about. It must be https:// anywhere but
# localhost — the search carries a patient's name in its query string and their
# identifiers in its answer, and every call carries either a claim code or a
# launch_id that resolves to an EHR access token.
#
# VITE_SMART_ISS is not an origin of ours at all: it is the EHR's FHIR base URL,
# the `iss` a standalone launch has to supply because only an EHR-initiated
# launch carries its own. It holds one issuer because there is one
# pilot-relevant EHR target today — a scope limit rather than a design, since an
# issuer is per-practice as well as per-vendor and becomes a provider-facing
# selection the moment a second EHR-or-practice combination is onboarded. See
# CLAUDE.md, "Which EHR a client-initiated standalone launch targets", which
# settles it for both apps. Left empty, the app offers no standalone launch and
# says so; it never launches against an empty issuer. Not a credential.
#
# VITE_PRIOR_AUTH_URL is prior-auth, a fourth service on a fourth port
# (TASK-072): it routes a resubmission of a denied prior-authorization request.
# The dashboard's reads do not come from here — track-a-clinical owns
# prior_auth_requests and every read of it, so the queue and a denial reason
# come from VITE_API_BASE_URL. It must be https:// anywhere but localhost: a
# resubmission transmits a patient's prior-authorization bundle to a payer.
#
# There is deliberately no VITE_ counterpart to SMART_WEB_RETURN_URL above. The
# service owns where it redirects, and this app recognises a completed launch by
# the claim code in its own URL rather than by matching a path against a second
# copy of that setting — see apps/web/src/launch/inbound.ts for why a mismatch
# between two such copies would discard a launch that had already succeeded.
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=
VITE_TRACK_B_RAG_URL=
VITE_FHIR_BASE_URL=
VITE_PRIOR_AUTH_URL=
VITE_NUDGE_WS_URL=
VITE_AUDIO_WS_URL=
VITE_SMART_ISS=

# ---------------------------------------------------------------------------
# Mobile (apps/mobile — Expo requires the EXPO_PUBLIC_ prefix)
#
# EXPO_PUBLIC_* values are inlined into the shipped bundle, so a host name is
# fine here and a credential never is. The session JWT is minted per encounter
# by TASK-006 and passed to the capture hook — it is not configuration.
#
# This app has five origins: two WebSocket and three HTTP, and none of them are
# interchangeable. A build that reuses one for another fails in a way that reads
# like a routing bug rather than a configuration one, which is why each is its
# own variable.
#
# The two WebSocket origins carry no path; each hook appends its own.
# EXPO_PUBLIC_AUDIO_WS_URL is audio-ingestion, and useAudioCapture (TASK-022)
# appends /ws/audio/{session_id}. EXPO_PUBLIC_NUDGE_WS_URL is nudge-service, and
# useNudgeStream (TASK-043) appends /ws/nudges/{session_id}. Both must be wss://
# anywhere but localhost: one carries encounter audio, the other a live stream of
# payer alerts naming an encounter's undocumented criteria, and both carry a
# session token in the handshake.
#
# The two HTTP origins are two services, exactly as on web.
# EXPO_PUBLIC_API_BASE_URL is track-a-clinical, which owns the session lifecycle
# routes (TASK-025) and the re-mint endpoint both sockets depend on.
# EXPO_PUBLIC_TRACK_B_RAG_URL is track-b-rag, which owns the nudge acknowledge
# route the banner's dismiss button calls (TASK-041b, wired up in TASK-043).
# EXPO_PUBLIC_FHIR_BASE_URL is fhir-integration, which owns the two routes that
# identify the patient a visit is about (TASK-025b): GET /fhir/launch-context,
# and GET /fhir/patient/search for a launch the EHR named nobody in. A third
# service, so a third origin — this app now talks to three, and collapsing them
# waits on the same Phase 6 gateway the web block above defers to.
# All three must be https:// anywhere but localhost — the start-visit body
# carries a patient identifier, a dismissal names a nudge belonging to an
# encounter, and the search carries a patient's name in its query string and
# their identifiers in its answer.
#
# EXPO_PUBLIC_SMART_ISS and EXPO_PUBLIC_SMART_RETURN_URI are the SMART launch
# (TASK-025c), and neither is an origin of ours: the first is the EHR's FHIR
# base URL — the `iss` a standalone launch has to supply, because only an
# EHR-initiated launch carries its own — and the second is this app's URI
# scheme, which the OS routes the completed launch back to.
#
# EXPO_PUBLIC_SMART_RETURN_URI must equal fhir-integration's
# SMART_MOBILE_RETURN_URI exactly, and its scheme must be the one registered in
# apps/mobile/app.json. Two halves of one handoff configured separately is a
# silent failure: the browser lands on a URL nothing handles and the app cannot
# tell that from a provider closing the login window.
#
# EXPO_PUBLIC_SMART_ISS holds one issuer because there is one pilot-relevant EHR
# target today. That is a scope limit rather than a design — an issuer is
# per-practice as well as per-vendor, and it becomes a provider-facing selection
# the moment a second EHR-or-practice combination is onboarded. See CLAUDE.md,
# "Which EHR a client-initiated standalone launch targets". Left empty, the app
# offers no standalone launch and says so; it never launches against an empty
# issuer. Neither value is a credential.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_TRACK_B_RAG_URL=
EXPO_PUBLIC_FHIR_BASE_URL=
EXPO_PUBLIC_NUDGE_WS_URL=
EXPO_PUBLIC_AUDIO_WS_URL=
EXPO_PUBLIC_SMART_ISS=
EXPO_PUBLIC_SMART_RETURN_URI=medauth://launch
